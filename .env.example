# WhatsApp Important Message Extractor - Environment Configuration

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# Custom Webhook URL (Optional)
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/api/alerts

# Storage Settings
DB_PATH=whatsapp_messages.db
JSON_LOG_PATH=important_messages.json

# Session Persistence Settings
USER_DATA_DIR=./whatsapp_user_data
HEADLESS=False
POLL_INTERVAL_SECONDS=15
